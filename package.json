{
  "name": "geneoapp",
  "version": "0.1.0",
  "private": true,
  "description": "Application de généalogie locale et hors ligne (React, Node.js/Express, SQLite, Electron)",
  "type": "module",
  "main": "src/electron/src/main.js",
  "bin": {
    "geneoapp": "src/cli/geneoapp.js"
  },
  "workspaces": [
    "src/client",
    "src/server",
    "src/db",
    "src/electron"
  ],
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "express": "^5.1.0",
    "pdfjs-dist": "^6.3.289",
    "tesseract.js": "^7.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "^1.0.0"
  },
  "scripts": {
    "build": "npm run build --workspace @geneoapp/client",
    "dev": "concurrently --kill-others-on-fail \"npm run dev --workspace @geneoapp/server\" \"npm run dev --workspace @geneoapp/client\"",
    "dev:lan": "cross-env GENEOAPP_HOST=0.0.0.0 concurrently --kill-others-on-fail \"npm run dev --workspace @geneoapp/server\" \"npm run dev --workspace @geneoapp/client\"",
    "electron": "npm run build && npm run start --workspace @geneoapp/electron",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "package": "npm run build && electron-builder --mac --win --linux",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && node scripts/check-imports.js",
    "migrate": "npm run migrate --workspace @geneoapp/db",
    "smoke": "node --test test/smoke/*.test.js",
    "test:db": "node --test test/db/*.test.js",
    "test:server": "node --test test/server/*.test.js",
    "test:api": "node --test test/api/*.test.js",
    "test:electron": "node --test test/electron/*.test.js",
    "test:packaging": "node --test test/packaging/*.test.js",
    "test:cli": "node --test test/cli/*.test.js",
    "cli": "node src/cli/geneoapp.js",
    "test:client": "npm run test --workspace @geneoapp/client",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/capture-screenshots.js",
    "test": "npm run smoke && npm run test:db && npm run test:server && npm run test:api && npm run test:electron && npm run test:packaging && npm run test:cli && npm run test:client",
    "storybook": "npm run storybook --workspace @geneoapp/client",
    "build-storybook": "npm run build-storybook --workspace @geneoapp/client"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.63.0",
    "playwright-core": "^1.63.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^38.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.35.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.3.0",
    "js-yaml": "^5.4.2",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
